{
  "name": "nivora-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "NIVORA \u2014 The Rental Living Ecosystem. Interactive competition prototype (fictional demo data).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --port 4174",
    "check:bundles": "node scripts/check-presenter-bundle.mjs",
    "images:fetch": "node scripts/fetch-images.mjs",
    "preflight": "node scripts/preflight.mjs",
    "images:install": "node scripts/install-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
